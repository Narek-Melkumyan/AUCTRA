// AUCTRA relational schema (PostgreSQL, Prisma 7).
//
// Conventions
// - Primary keys are UUIDs generated by the database (gen_random_uuid()).
// - Money is stored as BigInt minor units (e.g. cents) plus an ISO-4217 currency code.
//   It is never stored as floating point. The API serialises it as a decimal string.
// - Table names are snake_case plurals; column names follow Prisma field names.
// - Invariants Prisma cannot express (CHECK constraints, partial unique indexes)
//   live in hand-written SQL migrations (see prisma/migrations/*_constraints).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum SellerType {
  PRIVATE
  DEALER
  BUSINESS
}

enum AddressType {
  SHIPPING
  BILLING
  PICKUP
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  USER_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  TOKEN_REUSE
  ADMIN
  ACCOUNT_SUSPENDED
}

enum AuctionStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  LIVE
  ENDED
  SOLD
  UNSOLD
  CANCELLED
}

enum AuctionVisibility {
