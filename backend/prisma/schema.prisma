}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

/// Where a listing image lives.
enum MediaStorage {
  /// An https:// URL hosted elsewhere (legacy / API-supplied).
  EXTERNAL
  /// asset://name, an image bundled with the frontend (demo seed data).
  BUNDLED
  /// Processed WebP variants in Cloudflare R2.
  R2
  /// Processed WebP variants on the API server's disk (development only).
  LOCAL
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
  DATE
}

enum BidStatus {
