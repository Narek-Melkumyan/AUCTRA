  VOIDED
}

enum AuctionEventType {
  CREATED
  UPDATED
  SUBMITTED_FOR_REVIEW
  APPROVED
  REJECTED
  STARTED
  BID_PLACED
  EXTENDED
  ENDED
  SOLD
  UNSOLD
  CANCELLED
}

enum NotificationType {
