// ───────────────────────── Users & access ─────────────────────────

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lower-cased (enforced by a CHECK constraint).
  email             String     @unique @db.VarChar(320)
  emailVerifiedAt   DateTime?  @db.Timestamptz(3)
  /// Argon2id PHC string. Never serialised to clients.
  passwordHash      String
  passwordChangedAt DateTime   @default(now()) @db.Timestamptz(3)
  status            UserStatus @default(ACTIVE)
  suspendedUntil    DateTime?  @db.Timestamptz(3)
  suspensionReason  String?    @db.VarChar(500)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?  @db.Timestamptz(3)
  lastLoginAt       DateTime?  @db.Timestamptz(3)
  deletedAt         DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  profile              UserProfile?
  preferences          UserPreference?
  addresses            UserAddress[]
  roles                UserRole[]
  rolesGranted         UserRole[]                @relation("RoleGrantedBy")
  identityVerification IdentityVerification?
  sellerProfile        SellerProfile?
  sessions             Session[]
  tokens               VerificationToken[]
  auditLogs            AuditLog[]                @relation("AuditActor")
  auctionsSelling      Auction[]                 @relation("AuctionSeller")
  auctionsWon          Auction[]                 @relation("AuctionWinner")
  bids                 Bid[]
  auctionEvents        AuctionEvent[]
  watchlist            WatchlistItem[]
  favorites            Favorite[]
  reminders            AuctionReminder[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  ordersAsBuyer        Order[]                   @relation("OrderBuyer")
  ordersAsSeller       Order[]                   @relation("OrderSeller")
  payouts              Payout[]
  conversations        ConversationParticipant[]
  messagesSent         Message[]
  reportsFiled         Report[]                  @relation("ReportReporter")
  reportsHandled       Report[]                  @relation("ReportHandler")
  disputesOpened       Dispute[]                 @relation("DisputeOpener")
  disputesHandled      Dispute[]                 @relation("DisputeHandler")
  chatMessages         AuctionChatMessage[]      @relation("ChatAuthor")
  chatModerated        AuctionChatMessage[]      @relation("ChatModerator")
  chatRestrictions     ChatRestriction[]         @relation("ChatRestricted")
  chatRestrictionsSet  ChatRestriction[]         @relation("ChatRestrictionCreator")
  chatRestrictionsLift ChatRestriction[]         @relation("ChatRestrictionRevoker")
  announcements        Announcement[]            @relation("AnnouncementAuthor")
  mediaUploaded        ListingMedia[]            @relation("MediaUploader")
  aiConversations      AiConversation[]
  aiUsage              AiUsage[]
  moderationActions    ModerationAction[]        @relation("ModerationModerator")
  moderationReceived   ModerationAction[]        @relation("ModerationSubjectUser")
  idempotencyKeys      IdempotencyKey[]
  configUpdates        SystemConfig[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String   @db.VarChar(80)
  /// Public pseudonymous handle. Unique, case-insensitive (stored lower-case).
  handle      String   @unique @db.VarChar(32)
  avatarUrl   String?  @db.VarChar(2048)
  bio         String?  @db.VarChar(1000)
  phone       String?  @db.VarChar(32)
  /// ISO-3166-1 alpha-2 code.
  country     String?  @db.Char(2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  userId            String   @id @db.Uuid
  locale            String   @default("en-US") @db.VarChar(16)
  timezone          String   @default("UTC") @db.VarChar(64)
  preferredCurrency String   @default("USD") @db.Char(3)
  marketingOptIn    Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserAddress {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @db.Uuid
  type       AddressType @default(SHIPPING)
  label      String?     @db.VarChar(60)
  fullName   String      @db.VarChar(120)
  line1      String      @db.VarChar(200)
  line2      String?     @db.VarChar(200)
  city       String      @db.VarChar(100)
  region     String?     @db.VarChar(100)
  postalCode String?     @db.VarChar(20)
  country    String      @db.Char(2)
  phone      String?     @db.VarChar(32)
  /// At most one default per (user, type): enforced by a partial unique index.
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@index([userId])
  @@map("user_addresses")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// USER, SELLER, ADMIN, SUPER_ADMIN, … New roles are data, not code.
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// System roles cannot be deleted through the API.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "auction:create", "auction:moderate", "user:suspend".
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  grantedById String?  @db.Uuid
  grantedAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Identity (KYC) verification state. Documents are held by the verification
/// provider; only its reference is stored here.
model IdentityVerification {
  userId          String             @id @db.Uuid
  status          VerificationStatus @default(NOT_STARTED)
  provider        String?            @db.VarChar(50)
  providerRef     String?            @db.VarChar(200)
  submittedAt     DateTime?          @db.Timestamptz(3)
  verifiedAt      DateTime?          @db.Timestamptz(3)
  rejectionReason String?            @db.VarChar(500)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("identity_verifications")
}

model SellerProfile {
  userId             String             @id @db.Uuid
  type               SellerType         @default(PRIVATE)
  businessName       String?            @db.VarChar(200)
  /// Tax/registration number — store only when legally required.
  registrationNumber String?            @db.VarChar(100)
  description        String?            @db.VarChar(2000)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  rejectionReason    String?            @db.VarChar(500)
  /// Payment provider connected-account reference (e.g. Stripe acct_…). No bank details.
  payoutAccountRef   String?            @db.VarChar(200)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("seller_profiles")
}

// ──────────────────────── Auth & sessions ────────────────────────

/// A login on one device. The session is also the refresh-token family:
/// every rotated refresh token belongs to exactly one session.
model Session {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @db.Uuid
  /// Truncated user agent, for the "active sessions" screen.
  userAgent    String?              @db.VarChar(255)
  /// Salted SHA-256 of the client IP — lets users compare sessions without storing raw IPs.
  ipHash       String?              @db.VarChar(64)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  lastActiveAt DateTime             @default(now()) @db.Timestamptz(3)
  /// Absolute lifetime; refresh rotation never extends past this.
  expiresAt    DateTime             @db.Timestamptz(3)
  revokedAt    DateTime?            @db.Timestamptz(3)
  revokeReason SessionRevokeReason?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Refresh tokens are opaque: "<id>.<secret>". Only SHA-256(secret) is stored.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique @db.Char(64)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  /// Set when this token is exchanged; any later use is treated as reuse.
  usedAt       DateTime? @db.Timestamptz(3)
  replacedById String?   @unique @db.Uuid
  revokedAt    DateTime? @db.Timestamptz(3)

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshRotation")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use email verification / password reset tokens. Only SHA-256 hashes are stored.
model VerificationToken {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @db.Char(64)
  /// HMAC-SHA256 of the 6-digit email code, keyed by a server secret and bound to this
  /// row's id. Only set for EMAIL_VERIFICATION. The link and the code share `usedAt`, so
  /// using either one consumes both.
  codeHash  String?      @db.Char(64)
  /// Wrong-code attempts; the request is void once the limit is reached.
  attempts  Int          @default(0)
  expiresAt DateTime     @db.Timestamptz(3)
  usedAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// Security- and business-relevant activity (logins, role changes, admin actions…).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  /// e.g. "auth.login", "auth.refresh_reuse", "auction.cancel", "user.suspend".
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(50)
  entityId   String?  @db.VarChar(100)
  ipHash     String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  /// Structured details. Must never contain secrets, tokens or password material.
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─────────────────────── Catalogue & listings ───────────────────────

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(1000)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  parent           Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]          @relation("CategoryTree")
  attributes       CategoryAttribute[]
  auctions         Auction[]           @relation("AuctionCategory")
  auctionsInSubcat Auction[]           @relation("AuctionSubcategory")

  @@index([parentId, sortOrder])
  @@map("categories")
}

/// Custom attribute definitions per category (inherited by subcategories in the service layer).
model CategoryAttribute {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String        @db.Uuid
  key        String        @db.VarChar(60)
  label      String        @db.VarChar(120)
  type       AttributeType
  isRequired Boolean       @default(false)
  /// Allowed values for ENUM attributes.
  options    String[]      @default([])
  unit       String?       @db.VarChar(20)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   AuctionAttributeValue[]

  @@unique([categoryId, key])
  @@map("category_attributes")
}

model Auction {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-friendly lot number (LOT 1001…).
  lotNumber       Int           @unique @default(autoincrement())
  sellerId        String        @db.Uuid
  categoryId      String        @db.Uuid
  subcategoryId   String?       @db.Uuid
  title           String        @db.VarChar(200)
  description     String        @db.Text
  condition       ItemCondition
  conditionNotes  String?       @db.VarChar(2000)
  locationCity    String?       @db.VarChar(100)
  locationRegion  String?       @db.VarChar(100)
  locationCountry String?       @db.Char(2)
  currency        String        @default("USD") @db.Char(3)

  startingPriceCents BigInt
  minIncrementCents  BigInt
  /// Hidden from the public API; clients only see whether it has been met.
  reservePriceCents  BigInt?
  buyNowPriceCents   BigInt?
  /// Denormalised highest accepted bid, maintained only by the bidding transaction.
  currentPriceCents  BigInt?
  highestBidId       String? @unique @db.Uuid
  bidCount           Int     @default(0)

  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  /// Original scheduled end, kept when anti-sniping extends `endsAt`.
  originalEndsAt DateTime          @db.Timestamptz(3)
  status         AuctionStatus     @default(DRAFT)
  visibility     AuctionVisibility @default(PUBLIC)

  /// Optional anti-sniping: a bid inside the final `antiSnipingWindowSec` pushes
  /// `endsAt` to now + `antiSnipingExtensionSec`. Disabled unless the seller opts in.
  antiSnipingEnabled      Boolean @default(false)
  antiSnipingWindowSec    Int     @default(0)
  antiSnipingExtensionSec Int     @default(0)

  fulfillmentMethod FulfillmentMethod @default(SHIPPING)
  shippingNotes     String?           @db.VarChar(2000)
  inspectionNotes   String?           @db.VarChar(2000)

  winnerId             String?   @db.Uuid
  winningBidId         String?   @unique @db.Uuid
  /// Monotonic version, incremented on every state change. Realtime events carry it
  /// so clients can drop stale events and detect gaps.
  version              Int       @default(1)
  endingSoonNotifiedAt DateTime? @db.Timestamptz(3)
  submittedAt          DateTime? @db.Timestamptz(3)
  approvedAt           DateTime? @db.Timestamptz(3)
  /// Stable key of a seeded demo listing (null for real listings). Makes catalog seeding
  /// idempotent and lets the UI label demo data.
  seedKey              String?   @unique @db.VarChar(80)
  endedAt              DateTime? @db.Timestamptz(3)
  settledAt            DateTime? @db.Timestamptz(3)
  cancelledAt          DateTime? @db.Timestamptz(3)
  cancelReason         String?   @db.VarChar(500)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  seller      User      @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  winner      User?     @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  category    Category  @relation("AuctionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Category? @relation("AuctionSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  highestBid  Bid?      @relation("AuctionHighestBid", fields: [highestBidId], references: [id], onDelete: Restrict)
  winningBid  Bid?      @relation("AuctionWinningBid", fields: [winningBidId], references: [id], onDelete: Restrict)

  bids            Bid[]                   @relation("AuctionBids")
  media           ListingMedia[]
  attributeValues AuctionAttributeValue[]
  vehicle         VehicleDetails?
  watch           WatchDetails?
  events          AuctionEvent[]
  chatMessages    AuctionChatMessage[]
  watchers        WatchlistItem[]
  favorites       Favorite[]
  reminders       AuctionReminder[]
  order           Order?
  conversations   Conversation[]

  /// Composite key target so bids can reference (auction, currency) and can never
  /// be recorded in a different currency from their auction.
  @@unique([id, currency])
  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([categoryId, status, endsAt])
  @@index([sellerId, status])
  @@index([winnerId])
  @@map("auctions")
}

model ListingMedia {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId        String       @db.Uuid
  type             MediaType    @default(IMAGE)
  /// Full-size image URL: the public URL of the "full" variant for stored images, or the
  /// external/bundled reference. No binary data in the DB.
  url              String       @db.VarChar(2048)
  altText          String?      @db.VarChar(300)
  /// Dimensions of the full-size variant (after EXIF orientation).
  width            Int?
  height           Int?
  /// Gallery order, 0-based and contiguous. The primary (cover) image is always position 0.
  position         Int          @default(0)
  isPrimary        Boolean      @default(false)
  storage          MediaStorage @default(EXTERNAL)
  /// Server-generated object key prefix "auctions/{auctionId}/{imageId}/" (stored images only).
  storageKeyPrefix String?      @unique @db.VarChar(200)
  /// Stored images: { thumbnail|card|full: { key, url, width, height, bytes } }.
  variants         Json?
  /// MIME type of the stored variants (image/webp).
  mimeType         String?      @db.VarChar(100)
  /// Total stored bytes across all variants.
  bytes            Int?
  /// Detected format and size of the uploaded original (the original itself is not kept).
  originalMimeType String?      @db.VarChar(100)
  originalBytes    Int?
  /// SHA-256 of the uploaded bytes, used to refuse the same photo twice on one auction.
  contentHash      String?      @db.Char(64)
  uploadedById     String?      @db.Uuid
  /// Attribution for third-party images (e.g. Wikimedia Commons): author, license name,
  /// license URL and source page. Null for photos uploaded by the seller.
  creditAuthor     String?      @db.VarChar(300)
  creditLicense    String?      @db.VarChar(60)
  creditLicenseUrl String?      @db.VarChar(500)
  creditSourceUrl  String?      @db.VarChar(1000)
  /// Copyright notice / modification details shown with the credit (e.g. "Resized and
  /// converted to WebP", or "Illustrative photo, not the listed property").
  creditNotice     String?      @db.VarChar(500)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  auction    Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([auctionId, position])
  @@index([uploadedById])
  @@map("listing_media")
}

/// Object-storage prefixes that must be deleted. Written in the same transaction that
/// removes or replaces an image, and before every upload starts (removed when the image
/// row commits), so a crash at any point can never leave untracked objects behind.
model MediaCleanupTask {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storage   MediaStorage
  keyPrefix String       @unique @db.VarChar(200)
  /// upload_pending | upload_failed | image_deleted | image_replaced
  reason    String       @db.VarChar(40)
  attempts  Int          @default(0)
  lastError String?      @db.VarChar(500)
  runAfter  DateTime     @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([runAfter])
  @@map("media_cleanup_tasks")
}

model AuctionAttributeValue {
  auctionId    String    @db.Uuid
  attributeId  String    @db.Uuid
  valueText    String?   @db.VarChar(1000)
  valueNumber  Decimal?  @db.Decimal(20, 6)
  valueBoolean Boolean?
  valueDate    DateTime? @db.Date

  auction   Auction           @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([auctionId, attributeId])
  @@index([attributeId, valueNumber])
  @@index([attributeId, valueText])
  @@map("auction_attribute_values")
}

/// Typed vehicle facts. Split out (rather than generic attributes) because VINs need
/// format checks and uniqueness, and make/model/year/mileage are primary search filters.
model VehicleDetails {
  auctionId     String  @id @db.Uuid
  vin           String? @db.VarChar(17)
  make          String  @db.VarChar(60)
  model         String  @db.VarChar(80)
  year          Int
  mileageKm     Int?
  transmission  String? @db.VarChar(30)
  fuelType      String? @db.VarChar(30)
  exteriorColor String? @db.VarChar(40)
  bodyStyle     String? @db.VarChar(40)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([make, model, year])
  @@map("vehicle_details")
}

/// Typed watch facts (brand/reference are the main search filters for watches).
model WatchDetails {
  auctionId       String   @id @db.Uuid
  brand           String   @db.VarChar(60)
  model           String   @db.VarChar(80)
  referenceNumber String?  @db.VarChar(60)
  year            Int?
  caseMaterial    String?  @db.VarChar(60)
  caseDiameterMm  Decimal? @db.Decimal(5, 2)
  movement        String?  @db.VarChar(60)
  hasBox          Boolean?
  hasPapers       Boolean?

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([brand, model])
  @@map("watch_details")
}

// ───────────────────────────── Bidding ─────────────────────────────

model Bid {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId          String    @db.Uuid
  bidderId           String    @db.Uuid
  amountCents        BigInt
  currency           String    @db.Char(3)
  /// Position of this bid in the auction (1, 2, 3 …). Assigned under the auction row
  /// lock, so ordering is deterministic even for bids in the same millisecond.
  sequence           Int
  /// Client-supplied key; retries with the same key return the original bid.
  idempotencyKey     String    @db.VarChar(100)
  status             BidStatus @default(ACCEPTED)
  /// Price before this bid (null for the opening bid) — useful for audits.
  previousPriceCents BigInt?
  ipHash             String?   @db.VarChar(64)
  voidedAt           DateTime? @db.Timestamptz(3)
  voidReason         String?   @db.VarChar(500)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  auction           Auction  @relation("AuctionBids", fields: [auctionId, currency], references: [id, currency], onDelete: Restrict)
  bidder            User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  highestForAuction Auction? @relation("AuctionHighestBid")
  winningForAuction Auction? @relation("AuctionWinningBid")

  @@unique([auctionId, sequence])
  @@unique([bidderId, idempotencyKey])
  @@index([auctionId, amountCents(sort: Desc)])
  @@index([bidderId, createdAt])
  @@map("bids")
}

/// Append-only lifecycle history for each auction.
model AuctionEvent {
  id         BigInt           @id @default(autoincrement())
  auctionId  String           @db.Uuid
  type       AuctionEventType
  actorId    String?          @db.Uuid
  fromStatus AuctionStatus?
  toStatus   AuctionStatus?
  /// Auction version after this event.
  version    Int
  metadata   Json?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auctionId, id])
  @@map("auction_events")
}

// ─────────────────────── Engagement & notifications ───────────────────────

model WatchlistItem {
  userId    String   @db.Uuid
  auctionId String   @db.Uuid
  /// Receive outbid/ending notifications for this auction.
  notify    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([auctionId])
  @@map("watchlist_items")
}

model Favorite {
  userId    String   @db.Uuid
  auctionId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([auctionId])
  @@map("favorites")
}

model AuctionReminder {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  auctionId String    @db.Uuid
  remindAt  DateTime  @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId, remindAt])
  @@index([sentAt, remindAt])
  @@map("auction_reminders")
}

model NotificationPreference {
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.VarChar(2000)
  auctionId String?          @db.Uuid
  data      Json?
  /// Prevents duplicates when a job retries (e.g. "outbid:<bidId>").
  dedupeKey String?          @db.VarChar(150)
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Administrative broadcast. Each recipient gets an ordinary ANNOUNCEMENT notification
/// (dedupe key "announcement:<id>"), so delivery status is tracked per recipient.
model Announcement {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String               @db.VarChar(200)
  body           String               @db.VarChar(2000)
  audience       AnnouncementAudience @default(ALL)
  sendEmail      Boolean              @default(false)
  link           String?              @db.VarChar(300)
  recipientCount Int                  @default(0)
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  createdBy User? @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("announcements")
}

model NotificationDelivery {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String              @db.Uuid
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  providerMessageId String?             @db.VarChar(200)
  lastError         String?             @db.VarChar(1000)
  sentAt            DateTime?           @db.Timestamptz(3)
  /// Earliest time the worker may (re)try; also used as a short claim lease while sending.
  nextAttemptAt     DateTime            @default(now()) @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@index([channel, status, nextAttemptAt])
  @@map("notification_deliveries")
}

// ─────────────────────── Orders & payments ───────────────────────

model Order {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable order number (ORD-…), unique.
  orderNumber       String             @unique @db.VarChar(30)
  /// One order per sold auction — the DB-level guard against double settlement.
  auctionId         String             @unique @db.Uuid
  buyerId           String             @db.Uuid
  sellerId          String             @db.Uuid
  currency          String             @db.Char(3)
  hammerPriceCents  BigInt
  buyerPremiumCents BigInt             @default(0)
  shippingCents     BigInt             @default(0)
  taxCents          BigInt             @default(0)
  /// = hammer + premium + shipping + tax (CHECK constraint).
  totalCents        BigInt
  status            OrderStatus        @default(PENDING_PAYMENT)
  paymentDueAt      DateTime?          @db.Timestamptz(3)
  paidAt            DateTime?          @db.Timestamptz(3)
  /// Set when the winner completes the simulated (demo) checkout. Never implies a real payment.
  demoCompletedAt   DateTime?          @db.Timestamptz(3)
  /// Buyer's delivery choice at checkout and a snapshot of the address used.
  fulfillmentMethod FulfillmentMethod?
  shippingAddress   Json?
  cancelledAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  auction        Auction         @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  buyer          User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         User            @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  paymentIntents PaymentIntent[]
  transactions   Transaction[]
  refunds        Refund[]
  fees           PlatformFee[]
  payouts        Payout[]
  invoice        Invoice?
  shipments      Shipment[]
  disputes       Dispute[]
  conversations  Conversation[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@map("orders")
}

/// Mirror of a provider payment intent. Card data never touches AUCTRA servers.
model PaymentIntent {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String              @db.Uuid
  provider         PaymentProvider
  providerIntentId String?             @db.VarChar(200)
  amountCents      BigInt
  currency         String              @db.Char(3)
  status           PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  /// True for DEMO provider rows: a simulated transaction, never a real charge.
  simulated        Boolean             @default(false)
  /// Sent to the provider so retried creations do not double-charge.
  idempotencyKey   String              @unique @db.VarChar(100)
  lastError        String?             @db.VarChar(1000)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([provider, providerIntentId])
  @@index([orderId])
  @@map("payment_intents")
}

/// Ledger of money movements (charges, refunds, payouts, fees).
model Transaction {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String            @db.Uuid
  paymentIntentId       String?           @db.Uuid
  type                  TransactionType
  status                TransactionStatus @default(PENDING)
  amountCents           BigInt
  currency              String            @db.Char(3)
  provider              PaymentProvider?
  /// True for DEMO provider rows: a simulated transaction, never a real charge.
  simulated             Boolean           @default(false)
  providerTransactionId String?           @db.VarChar(200)
  idempotencyKey        String            @unique @db.VarChar(100)
  metadata              Json?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  order         Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntent PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  auditTrail    TransactionAudit[]

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
  @@map("transactions")
}

model TransactionAudit {
  id            BigInt             @id @default(autoincrement())
  transactionId String             @db.Uuid
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  source        String             @db.VarChar(50)
  metadata      Json?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, id])
  @@map("transaction_audits")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String       @db.Uuid
  amountCents      BigInt
  currency         String       @db.Char(3)
  reason           String?      @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique @db.VarChar(200)
  idempotencyKey   String       @unique @db.VarChar(100)
  requestedById    String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refunds")
}

model PlatformFee {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @db.Uuid
  type        FeeType
  /// Rate in basis points used for the calculation (snapshot of system config).
  rateBps     Int
  amountCents BigInt
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@map("platform_fees")
}

model Payout {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId         String       @db.Uuid
  orderId          String       @db.Uuid
  amountCents      BigInt
  currency         String       @db.Char(3)
  status           PayoutStatus @default(PENDING)
  providerPayoutId String?      @unique @db.VarChar(200)
  idempotencyKey   String       @unique @db.VarChar(100)
  scheduledFor     DateTime?    @db.Timestamptz(3)
  paidAt           DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  seller User  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order  Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([sellerId, status])
  @@index([orderId])
  @@map("payouts")
}

model Invoice {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String        @unique @db.Uuid
  number     String        @unique @db.VarChar(40)
  status     InvoiceStatus @default(DRAFT)
  currency   String        @db.Char(3)
  totalCents BigInt
  /// Snapshot of line items at issue time.
  lineItems  Json
  issuedAt   DateTime?     @db.Timestamptz(3)
  dueAt      DateTime?     @db.Timestamptz(3)
  paidAt     DateTime?     @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

model Shipment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String            @db.Uuid
  method          FulfillmentMethod @default(SHIPPING)
  addressId       String?           @db.Uuid
  /// Address snapshot at shipping time (the user may later edit/delete the address).
  addressSnapshot Json?
  carrier         String?           @db.VarChar(60)
  trackingNumber  String?           @db.VarChar(100)
  status          ShipmentStatus    @default(PENDING)
  shippedAt       DateTime?         @db.Timestamptz(3)
  deliveredAt     DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  address UserAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([carrier, trackingNumber])
  @@map("shipments")
}

// ─────────────────────── Messaging, reports & moderation ───────────────────────

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId String?  @db.Uuid
  orderId   String?  @db.Uuid
  subject   String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  auction      Auction?                  @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([auctionId])
  @@index([orderId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime? @db.Timestamptz(3)
  joinedAt       DateTime  @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  body           String    @db.VarChar(4000)
  hiddenAt       DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Report {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId  String           @db.Uuid
  targetType  ReportTargetType
  targetId    String           @db.Uuid
  reason      String           @db.VarChar(100)
  details     String?          @db.VarChar(4000)
  status      ReportStatus     @default(OPEN)
  handledById String?          @db.Uuid
  resolution  String?          @db.VarChar(2000)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  reporter  User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model Dispute {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String        @db.Uuid
  openedById  String        @db.Uuid
  reason      String        @db.VarChar(100)
  details     String?       @db.VarChar(4000)
  status      DisputeStatus @default(OPEN)
  handledById String?       @db.Uuid
  resolution  String?       @db.VarChar(2000)
  resolvedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy  User  @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  handledBy User? @relation("DisputeHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("disputes")
}

/// Public chat attached to one auction room. `seq` is the global, gap-free-enough cursor
/// clients use for pagination and missed-message sync.
model AuctionChatMessage {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq              BigInt            @unique @default(autoincrement())
  auctionId        String            @db.Uuid
  authorId         String            @db.Uuid
  /// Plain text only (rendered as text by clients, never as HTML). Max 500 chars.
  body             String            @db.VarChar(500)
  status           ChatMessageStatus @default(VISIBLE)
  /// Client-generated id so a retried send is stored once.
  clientMessageId  String?           @db.VarChar(64)
  moderatedById    String?           @db.Uuid
  moderatedAt      DateTime?         @db.Timestamptz(3)
  moderationReason String?           @db.VarChar(500)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  auction     Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  author      User    @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  moderatedBy User?   @relation("ChatModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([authorId, clientMessageId])
  @@index([auctionId, seq])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@map("auction_chat_messages")
}

/// Mutes (temporary) and bans (until lifted) from auction chat. Active = not revoked and
/// (no expiry or expiry in the future).
model ChatRestriction {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @db.Uuid
  type        ChatRestrictionType
  reason      String?             @db.VarChar(500)
  expiresAt   DateTime?           @db.Timestamptz(3)
  createdById String?             @db.Uuid
  revokedAt   DateTime?           @db.Timestamptz(3)
  revokedById String?             @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  user      User  @relation("ChatRestricted", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ChatRestrictionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("ChatRestrictionRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([createdAt])
  @@map("chat_restrictions")
}

model ModerationAction {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moderatorId   String?              @db.Uuid
  action        ModerationActionType
  targetType    ReportTargetType
  targetId      String               @db.Uuid
  subjectUserId String?              @db.Uuid
  reason        String?              @db.VarChar(2000)
  reportId      String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  moderator   User? @relation("ModerationModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  subjectUser User? @relation("ModerationSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([subjectUserId])
  @@map("moderation_actions")
}

// ─────────────────────── AI assistants ───────────────────────

/// One assistant thread. USER and ADMIN scopes never share threads or tools.
model AiConversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  scope     AiScope
  title     String   @db.VarChar(120)
  /// Auction the user was viewing when the thread started (context only).
  auctionId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  usage    AiUsage[]

  @@index([userId, scope, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String        @db.Text
  /// Structured, server-generated extras: listings returned by tools, proposed admin
  /// actions, tool names used. Never model-invented records.
  data           Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Token accounting per model request, used for daily budgets and reporting.
model AiUsage {
  id             BigInt   @id @default(autoincrement())
  userId         String?  @db.Uuid
  conversationId String?  @db.Uuid
  scope          AiScope
  model          String   @db.VarChar(80)
  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  toolCalls      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// ─────────────────────── Platform infrastructure ───────────────────────

model SystemConfig {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_config")
}

/// Inbound webhooks (e.g. Stripe). (provider, eventId) uniqueness makes processing idempotent.
model WebhookEvent {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String        @db.VarChar(50)
  eventId           String        @db.VarChar(200)
  type              String        @db.VarChar(100)
  payload           Json
  signatureVerified Boolean       @default(false)
  status            WebhookStatus @default(RECEIVED)
  attempts          Int           @default(0)
  lastError         String?       @db.VarChar(2000)
  receivedAt        DateTime      @default(now()) @db.Timestamptz(3)
  processedAt       DateTime?     @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Generic HTTP idempotency records for non-bid mutations.
model IdempotencyKey {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String            @db.Uuid
  scope        String            @db.VarChar(100)
  key          String            @db.VarChar(100)
  requestHash  String            @db.Char(64)
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime          @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox. Rows are written in the same DB transaction as the state
/// change and relayed to Socket.IO/Redis afterwards, so committed events are never lost.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String    @db.VarChar(50)
  aggregateId   String    @db.Uuid
  /// Aggregate version (e.g. auction.version) after the change.
  version       Int
  type          String    @db.VarChar(100)
  payload       Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @db.VarChar(1000)
  /// Earliest time the relay may retry after a failure.
  availableAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([aggregateType, aggregateId, id])
  @@map("outbox_events")
}
