# AUCTRA API configuration. Copy to backend/.env (git-ignored) and fill in real values.
# Generate secrets with:  openssl rand -base64 48

NODE_ENV=development
PORT=4000

# PostgreSQL. Native install: port 5432. docker-compose.yml: port 5434.
DATABASE_URL="postgresql://auctra:CHANGE_ME@localhost:5432/auctra?schema=public"
# Integration tests refuse to run unless the database name ends in _test.
DATABASE_URL_TEST="postgresql://auctra:CHANGE_ME@localhost:5432/auctra_test?schema=public"
DATABASE_POOL_MAX=10

# Allowed browser origins (comma-separated). Used for CORS, CSRF origin checks and Socket.IO.
FRONTEND_ORIGIN="http://localhost:8080"
# Frontend base URL used in emailed links (/verify-email, /reset-password, /room/:id).
FRONTEND_URL="http://localhost:8080"
# Number of reverse-proxy hops to trust for client IPs (0 when exposed directly).
TRUST_PROXY_HOPS=0

# Auth. Both secrets ≥ 32 chars and different from each other.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_IDLE_DAYS=7
REFRESH_RACE_GRACE_SEC=10
CSRF_SECRET=
# Must be true in production (HTTPS). Optional COOKIE_DOMAIN for a shared parent domain.
COOKIE_SECURE=false
# COOKIE_DOMAIN=
# Salt for hashing client IPs in audit/session metadata (required in production).
IP_HASH_SALT=
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Argon2id cost (OWASP baseline defaults).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Redis: Socket.IO fan-out across instances + shared rate-limit counters. Optional for a
# single instance; required behind a multi-instance load balancer.
REDIS_URL="redis://localhost:6379"

# Email via Resend (https://resend.com). With RESEND_API_KEY set the provider defaults to
# "resend". RESEND_FROM_EMAIL must be on a domain verified in Resend (for quick tests Resend
# allows "onboarding@resend.dev", which only delivers to your own Resend account address).
RESEND_API_KEY=
RESEND_FROM_EMAIL="AUCTRA <no-reply@your-verified-domain.com>"
# Override: "log" prints emails to the server log in development and marks them NOT
# delivered; "disabled" drops them. "log" is refused in production.
# EMAIL_PROVIDER=log

# OpenAI (Responses API) for the user and admin assistants. Without a key the assistants
# report "not configured" — no responses are faked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Daily token budgets (input + output) per user, per admin, and for the whole platform.
AI_USER_DAILY_TOKENS=60000
AI_ADMIN_DAILY_TOKENS=250000
AI_GLOBAL_DAILY_TOKENS=2000000
AI_MAX_INPUT_CHARS=2000

# Business rules (documented defaults).
BIDDING_REQUIRE_VERIFIED_EMAIL=true
AUCTION_REQUIRE_REVIEW=true
ENDING_SOON_MINUTES=15

# Bid admission per instance (performance guard; correctness is the DB row lock).
# BID_MAX_CONCURRENT_TX=7          # default: DATABASE_POOL_MAX - 3
BID_QUEUE_MAX_PER_AUCTION=500
BID_LOCK_TIMEOUT_MS=3000

# Prometheus scrape token for GET /api/metrics (disabled when empty, >= 24 chars).
METRICS_TOKEN=
# LOG_HTTP=true                    # log every request (5xx and slow ones are always logged)

# Background work (each instance can run them; rows are claimed with SKIP LOCKED).
RATE_LIMIT_ENABLED=true
LIFECYCLE_WORKER_ENABLED=true
LIFECYCLE_INTERVAL_MS=1000
OUTBOX_RELAY_ENABLED=true
OUTBOX_INTERVAL_MS=250

# `npm run db:seed:demo` creates *@auctra.local demo accounts with this password (dev only).
SEED_DEMO_PASSWORD=

# ── Listing images ────────────────────────────────────────────────────
# Uploaded photos are validated and re-encoded with Sharp into three WebP variants
# (320 / 800 / 1600 px wide, never upscaled) and stored in Cloudflare R2.
# MEDIA_STORAGE: r2 | local | disabled. Default: r2 when any R2_* value is set,
# local in development, disabled otherwise. "local" (files under MEDIA_LOCAL_DIR, served
# by the API at /media) is for development only and is refused in production.
# MEDIA_STORAGE=r2

# Cloudflare R2 (see docs/media-storage.md). Use an API token scoped to this bucket with
# "Object Read & Write" only. These values stay on the server; the browser never sees them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=auctra
# Public base URL that serves the bucket: its r2.dev URL (development) or a custom domain
# connected to the bucket (production), e.g. https://media.example.com. A private bucket
# does NOT expose public URLs; enable public access first.
R2_PUBLIC_BASE_URL=
# Optional endpoint override (default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com),
# e.g. the EU jurisdiction endpoint https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com.
# R2_ENDPOINT=

# Optional namespace in front of every object key, so several environments can share one
# bucket: keys become <prefix>/auctions/{auctionId}/{imageId}/{variant}.webp. Leave empty
# in production; e.g. "dev" locally. Lowercase letters, digits, "-", up to 4 segments.
# MEDIA_KEY_PREFIX=
# Development disk storage (MEDIA_STORAGE=local).
# MEDIA_LOCAL_DIR=storage/media
# MEDIA_LOCAL_PUBLIC_URL=http://localhost:4000/media

# Upload limits.
MEDIA_MAX_UPLOAD_MB=10
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_IMAGES_PER_AUCTION=12
# Images decoded at the same time per instance, and how many may wait (then 503 MEDIA_BUSY).
MEDIA_PROCESSING_CONCURRENCY=2
MEDIA_PROCESSING_QUEUE_MAX=16
